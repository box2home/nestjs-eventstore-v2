{
  "name": "nestjs-eventstore",
  "version": "1.4.14",
  "description": "Event Store connector for Nest js",
  "author": "Taimoor Alam <taimoor.alam@daypaio.com>",
  "license": "MIT",
  "readmeFilename": "README.md",
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "*.md"
  ],
  "scripts": {
    "start:dev": "tsc -w",
    "build": "tsc",
    "prepare": "npm run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "check-lite": "npm run lint:fix && npm run prepare",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix"
  },
  "keywords": [
    "nestjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daypaio/nestjs-eventstore"
  },
  "bugs": "https://github.com/daypaio/nestjs-eventstore/issues",
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/cqrs": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "node-eventstore-client": "22.10.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/common": "^11.1.11",
    "@nestjs/core": "^11.1.11",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/testing": "^11.1.11",
    "@types/express": "^4.17.3",
    "@types/jest": "^30.0.0",
    "@types/long": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-watch": "^7.2.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".spec.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^node-eventstore-client$": "<rootDir>/__tests__/__mocks__/node-eventstore-client.ts"
    },
    "setupFiles": [
      "reflect-metadata"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
